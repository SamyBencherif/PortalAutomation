# The target application. Nothing but the app -- no automation tooling, no
# browser. Keeping it minimal is part of the point: this stands in for a vendor
# system we would never be able to modify or instrument.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY mock_teller /app/mock_teller

EXPOSE 8800
CMD ["uvicorn", "mock_teller.app:app", "--host", "0.0.0.0", "--port", "8800"]
