# Copy to .env and fill in. .env is gitignored and never read into an artifact
# or a run log -- see cua/safety/policy.py.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# CUA_TARGET=http://target:8800
# CUA_VNC_URL=http://localhost:6080/vnc.html
# CUA_CONSOLE_PORT=8080

# Reaching an operator who is not already watching. Without a webhook the queue
# still runs; it just cannot tell anyone who is not looking at it.
# CUA_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
# CUA_DISPATCHER=http://dispatcher:8090
# CUA_QUEUE_PORT=8090
# CUA_CONSOLE_URL=http://localhost:8090
